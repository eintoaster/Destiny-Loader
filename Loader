SPGradTable(stops, a)
{
    static cache := Map()
    key := ObjPtr(stops) ":" a
    if (cache.Has(key))
        return cache[key]
    if (cache.Count > 800)
        cache.Clear()
    m := stops.Length
    n := m + 1
    cols := Buffer(4 * n), pos := Buffer(4 * n)
    Loop n {
        c := stops[Mod(A_Index - 1, m) + 1]
        NumPut("UInt", (a << 24) | (c[1] << 16) | (c[2] << 8) | c[3], cols, (A_Index - 1) * 4)
        NumPut("Float", (A_Index - 1) / m, pos, (A_Index - 1) * 4)
    }
    cache[key] := {m: m, n: n, cols: cols, pos: pos, stops: stops}
    return cache[key]
}

