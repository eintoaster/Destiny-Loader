LoadGames(txt, pick := "")
{
    global GAMES, Sel, Changelog
    list := [], note := ""
    Loop Parse, txt, "`n", "`r" {
        ln := Trim(A_LoopField)
        if (ln = "" || SubStr(ln, 1, 1) = "#")
            continue
        if (SubStr(ln, 1, 10) = "changelog|") {
            note := Trim(SubStr(ln, 11))
            continue
        }
        f := StrSplit(ln, "|", " `t")
        if (f.Length >= 3 && f[1] != "" && SubStr(f[3], 1, 8) = "https://")
            list.Push({name: f[1], sub: f[2], url: f[3]})
    }
    if (!list.Length)
        return false
    Changelog := note
    cur := pick != "" ? pick : GAMES[Sel].name
    GAMES := list, Sel := 1
    for i, gm in GAMES
        if (gm.name = cur)
            Sel := i
    return true
}

