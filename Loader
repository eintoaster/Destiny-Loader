CosmicCard(x, y, w, h, r, t)
{
    global NLG
    static stars := []
    if (!stars.Length)
        Loop 38
            stars.Push({x: Random(0.0, 1.0), y: Random(0.0, 1.0), z: Random(0.25, 1.0), ph: Random(0.0, 6.28), sz: Random(0.5, 1.5)})
    DllCall("gdiplus\GdipSetClipPath", "Ptr", NLG, "Ptr", NLPathK(x, y, w, h, r), "Int", 0)
    NLRR(x, y, w, h, 0, NLC(14, 8, 32, 170))
    NLGlow(x + w * 0.72 + 18 * Sin(t * 0.5), y + h * 0.35 + 5 * Cos(t * 0.4), 110, 44, 0x6D28D9, 90)
    NLGlow(x + w * 0.92 + 10 * Cos(t * 0.6), y + h * 0.9, 80, 34, 0xDB2777, 60)
    NLGlow(x + w * 0.2, y + h * 0.5 + 6 * Sin(t * 0.7), 100, 40, 0x4338CA, 80)
    NLGlow(x + w * 0.5, y + h * 0.5, 90, 22, 0xA21CAF, Round(40 + 14 * Sin(t * 0.9)))
    for s in stars {
        sx := x + Mod(s.x * w - t * 12 * s.z + w * 40, w)
        sy := y + s.y * h
        a := Round(255 * s.z * (0.55 + 0.45 * Sin(t * (1.2 + s.z * 2) + s.ph)))
        rad := s.sz * (0.6 + 0.6 * s.z)
        NLDisc(sx, sy, rad, NLC(235, 230, 255, a))
        if (s.sz > 1.3 && s.z > 0.7) {
            NLLineW(sx - rad * 3, sy, sx + rad * 3, sy, NLC(220, 210, 255, a // 2), 0.8)
            NLLineW(sx, sy - rad * 3, sx, sy + rad * 3, NLC(220, 210, 255, a // 2), 0.8)
        }
    }
    sp := Mod(t * 1000 + 900, 3200)
    if (sp < 700) {
        q := sp / 700, fa := Sin(q * 3.1416)
        hx := x + w + 20 - (w * 0.75) * q, hy := y + 4 + (h - 14) * q
        Loop 12 {
            f := A_Index / 12, g := (A_Index + 1) / 12
            NLLineW(hx + 90 * f, hy - 26 * f * (h / 62), hx + 90 * g, hy - 26 * g * (h / 62), NLC(255, 255, 255, Round(200 * (1 - f) * fa)), 1.5)
        }
        NLGlow(hx, hy, 6, 6, 0xF0ABFC, Round(200 * fa))
        NLDisc(hx, hy, 1.6, NLC(255, 255, 255, Round(255 * fa)))
    }
    DllCall("gdiplus\GdipResetClip", "Ptr", NLG)
}

