HttpStart(url, accept := "")
{
    global SrcDir
    if (SrcDir != "")
        return {text: FileText(SrcDir "\" StrReplace(RegExReplace(RegExReplace(url, "\?.*"), ".*/"), "%20", " "))}
    try {
        req := ComObject("WinHttp.WinHttpRequest.5.1")
        req.SetTimeouts(3000, 3000, 3000, 4000)
        req.Open("GET", url (InStr(url, "?") ? "&" : "?") "t=" A_TickCount, true)
        if (accept != "")
            req.SetRequestHeader("Accept", accept)
        req.Send()
        return {req: req}
    }
    return {text: ""}
}

HttpDone(h, &text)
{
    text := ""
    if (h.HasOwnProp("text")) {
        text := h.text
        return true
    }
    try {
        if (!h.req.WaitForResponse(0))
            return false
        if (h.req.Status = 200) {
            body := h.req.ResponseBody
            n := body.MaxIndex() + 1
            buf := Buffer(n)
            pv := NumGet(ComObjValue(body) + 8 + A_PtrSize, "Ptr")
            DllCall("RtlMoveMemory", "Ptr", buf, "Ptr", pv, "UPtr", n)
            text := StrGet(buf, n, "UTF-8")
        }
    }
    text := LTrim(text, Chr(0xFEFF))
    h.text := text
    return true
}

HttpGetText(url, accept := "")
{
    h := HttpStart(url, accept)
    while (!HttpDone(h, &text))
        Sleep(30)
    return text
}

