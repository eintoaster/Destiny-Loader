    Loop 4
        NLDisc(104 + A_Index * 8.5, y0 + 163 + A_Index * 5.2, 1.6, NLC(255, 246, 220))
    HWPoly([120, y0 + 156, 131, y0 + 170, 120, y0 + 186, 109, y0 + 170], goldD)
